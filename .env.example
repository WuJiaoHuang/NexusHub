# 仅供本机全新开发环境，密码为示例。生产环境请通过环境变量注入独立凭据。
MYSQL_ROOT_PASSWORD=nexushub_dev
MYSQL_PORT=13306
DB_HOST=localhost
DB_PORT=13306
DB_NAME=nexushub
DB_USERNAME=root
DB_PASSWORD=nexushub_dev
REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_PASSWORD=nexushub_dev
REDIS_DATABASE=0
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673
RABBITMQ_USERNAME=nexushub
RABBITMQ_PASSWORD=nexushub_dev
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=19200
PLACE_SEARCH_INDEX=nexushub_place
PLACE_SEARCH_REBUILD_BATCH_SIZE=500
PLACE_CACHE_STRATEGY=PASS_THROUGH
EVENT_SLOTS_WARMUP_ENABLED=true
REGISTRATION_PUBLISH_CONFIRM_TIMEOUT_MS=5000
# 服务端管理员用户 ID 白名单，默认空值禁止全部管理写入；不要把所有注册用户加入。
ADMIN_USER_IDS=
ALIYUN_OSS_ENABLED=false
# 显式指定卷名；旧环境复用前必须阅读 docs/migration.md 并核对 docker volume ls。
MYSQL_DATA_VOLUME=nexushub-mysql-data
REDIS_DATA_VOLUME=nexushub-redis-data
RABBITMQ_DATA_VOLUME=nexushub-rabbitmq-data
ELASTICSEARCH_DATA_VOLUME=nexushub-elasticsearch-data
