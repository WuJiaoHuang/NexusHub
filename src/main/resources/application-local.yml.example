# 复制为 application-local.yml 并启用 local profile，仅供全新本机 Compose 环境。
spring:
  datasource:
    url: jdbc:mysql://localhost:13306/nexushub?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&useUnicode=true&characterEncoding=utf8
    username: ${DB_USERNAME:root}
    password: ${DB_PASSWORD:nexushub_dev}
  redis:
    host: localhost
    port: 16379
    password: ${REDIS_PASSWORD:nexushub_dev}
  rabbitmq:
    host: localhost
    port: 5673
    username: ${RABBITMQ_USERNAME:nexushub}
    password: ${RABBITMQ_PASSWORD:nexushub_dev}
  elasticsearch:
    host: localhost
    port: 19200
nexushub:
  cache:
    place-strategy: ${PLACE_CACHE_STRATEGY:PASS_THROUGH}
  search:
    place-index: ${PLACE_SEARCH_INDEX:nexushub_place}
